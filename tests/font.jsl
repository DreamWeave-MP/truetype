--!strict
-- `@truetype` over fonts the suite builds itself (./fixture): names and metrics, the character
-- map, advances, both kinds of kerning, outlines as a pen receives them, run metrics, and the
-- fonts it refuses.
local fixture = require './fixture'
local test = require '@jess/test'
local truetype = require '@truetype'

local expect = test.expect
local suite = test.new()

--- A pen that writes down what it is told, one command a line, numbers rounded to hundredths.
local function recorder(): (truetype.Pen, { string })
  local commands: { string } = {}

  local function number(value: number): string
    local rounded = math.floor(value * 100 + 0.5) / 100

    return if rounded == math.floor(rounded) then string.format('%d', rounded) else tostring(rounded)
  end

  local pen: truetype.Pen = {
    moveTo = function(toX: number, toY: number)
      table.insert(commands, `M {number(toX)} {number(toY)}`)
    end,
    lineTo = function(toX: number, toY: number)
      table.insert(commands, `L {number(toX)} {number(toY)}`)
    end,
    quadTo = function(controlX: number, controlY: number, toX: number, toY: number)
      table.insert(commands, `Q {number(controlX)} {number(controlY)} {number(toX)} {number(toY)}`)
    end,
    close = function()
      table.insert(commands, 'Z')
    end,
  }

  return pen, commands
end

suite.describe('load', function()
  suite.it('reads the names and the vertical metrics', function()
    local font = truetype.load(fixture.kerned())

    expect(font.family).toBe 'Test Sans'
    expect(font.subfamily).toBe 'Bold'
    expect(font.fullName).toBe 'Test Sans Bold'
    expect(font.version).toBe 'Version 1.000'
    expect(font.unitsPerEm).toBe(1000)
    expect(font.glyphCount).toBe(4)
    expect({ font.ascender, font.descender, font.lineGap }).toEqual { 800, -200, 100 }
    expect({ font.capHeight, font.xHeight }).toEqual { 700, 500 }
  end)

  suite.it('refuses what is not a TrueType font', function()
    expect(function()
      truetype.load(buffer.fromstring 'OTTO and some bytes')
    end).toThrow 'not a TrueType font'

    expect(function()
      truetype.load(buffer.create(4))
    end).toThrow 'too short'
  end)

  suite.it('names a table the font lacks', function()
    expect(function()
      truetype.load(fixture.without 'hmtx')
    end).toThrow "font has no 'hmtx' table"

    expect(function()
      truetype.load(fixture.without 'cmap')
    end).toThrow "font has no 'cmap' table"
  end)

  suite.it('names a file it cannot read', function()
    expect(function()
      truetype.load 'tests/no such font.ttf'
    end).toThrow "can't read font tests/no such font.ttf"
  end)
end)

suite.describe('characters', function()
  suite.it('maps characters to glyphs and the rest to the missing glyph', function()
    local font = truetype.load(fixture.kerned())

    expect({ font:glyph(65), font:glyph(66), font:glyph(67) }).toEqual { 1, 2, 3 }
    expect(font:glyph(64)).toBe(0)
    expect(font:glyph(68)).toBe(0)
    expect(font:glyph(0x1F600)).toBe(0)
  end)

  suite.it('lists the characters it lacks once each, in order', function()
    local font = truetype.load(fixture.kerned())

    expect(font:missing 'ABC').toEqual {}
    expect(font:missing 'AxBxé!').toEqual { 'x', 'é', '!' }
  end)

  suite.it('gives each glyph its advance', function()
    local font = truetype.load(fixture.kerned())

    expect({ font:advance(0), font:advance(1), font:advance(2), font:advance(3) }).toEqual { 0, 600, 600, 400 }
  end)
end)

suite.describe('kerning', function()
  suite.it('takes a pair set behind an extension lookup', function()
    local font = truetype.load(fixture.kerned())

    expect(font:kerning(1, 2)).toBe(-50)
    expect(font:kerning(1, 1)).toBe(0)
  end)

  suite.it('takes a pair of classes', function()
    local font = truetype.load(fixture.kerned())

    expect(font:kerning(2, 1)).toBe(-20)
    expect(font:kerning(2, 3)).toBe(0)
  end)

  suite.it('falls back to a kern table without GPOS', function()
    local font = truetype.load(fixture.legacy())

    expect(font:kerning(1, 3)).toBe(-30)
    expect(font:kerning(1, 2)).toBe(0)
  end)
end)

suite.describe('outline', function()
  suite.it('traces a contour on the curve as lines, y down from the origin', function()
    local font = truetype.load(fixture.kerned())
    local pen, commands = recorder()

    font:outline(pen, 'A', 1000, 0, 1000)

    expect(commands).toEqual { 'M 100 1000', 'L 100 300', 'L 500 300', 'L 500 1000', 'Z' }
  end)

  suite.it('starts a contour of control points between its last and first', function()
    local font = truetype.load(fixture.kerned())
    local pen, commands = recorder()

    font:outline(pen, 'B', 1000, 0, 1000)

    expect(commands).toEqual {
      'M 150 825',
      'Q 300 1000 450 825',
      'Q 600 650 450 475',
      'Q 300 300 150 475',
      'Q 0 650 150 825',
      'Z',
    }
  end)

  suite.it('moves and scales a composite glyph by its transform', function()
    local font = truetype.load(fixture.kerned())
    local pen, commands = recorder()

    font:outline(pen, 'C', 1000, 0, 1000)

    expect(commands).toEqual { 'M 100 1000', 'L 100 650', 'L 300 650', 'L 300 1000', 'Z' }
  end)

  suite.it('places each glyph at its kerned origin and scales to the size', function()
    local font = truetype.load(fixture.kerned())
    local pen, commands = recorder()

    font:outline(pen, 'AA', 100, 10, 100)

    expect(commands[1]).toBe 'M 20 100'
    expect(commands[6]).toBe 'M 80 100'
  end)
end)

suite.describe('measure', function()
  suite.it('measures the advance with kerning and tracking', function()
    local font = truetype.load(fixture.kerned())

    expect(font:measure('AB', 1000).width).toBe(1150)
    expect(font:measure('AB', 1000, { kerning = false }).width).toBe(1200)
    expect(font:measure('ABA', 1000, { tracking = 50 }).width).toBe(1800 - 70 + 100)
  end)

  suite.it('measures the ink box about the origin, y down', function()
    local font = truetype.load(fixture.kerned())
    local metrics = font:measure('AC', 1000)

    expect({ metrics.left, metrics.top, metrics.right, metrics.bottom }).toEqual { 100, -700, 900, 0 }
    expect({ metrics.ascent, metrics.descent, metrics.capHeight, metrics.xHeight }).toEqual { 800, 200, 700, 500 }
  end)

  suite.it('gives a run without ink an empty box', function()
    local font = truetype.load(fixture.kerned())
    local metrics = font:measure('', 1000)

    expect({ metrics.width, metrics.left, metrics.top, metrics.right, metrics.bottom }).toEqual { 0, 0, 0, 0, 0 }
  end)
end)

return suite
